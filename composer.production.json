{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "brunocfalcao/ai-bridge": "^1.2",
        "brunocfalcao/blade-feather-icons": "^6.0",
        "kraitebot/core": "^1.73",
        "laravel/framework": "^13.23.0",
        "laravel/horizon": "^5.47",
        "laravel/passkeys": "^0.2.1",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.2",
        "resend/resend-php": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kraitebot/core.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/brunocfalcao/ai-bridge.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/brunocfalcao/step-dispatcher.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/brunocfalcao/laravel-helpers.git"
        }
    ]
}
